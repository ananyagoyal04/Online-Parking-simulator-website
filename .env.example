# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide MongoDB connection URI. If offline or omitted, ParkWise will automatically run in Resilient In-Memory Mode.
MONGO_URI=mongodb://127.0.0.1:27017/parkwise

# JWT Secret for User Authentication & Signed Gate Passes
JWT_SECRET=parkwise_super_secure_jwt_secret_key_2026

# Client / CORS Allowed Origins (comma separated)
CORS_ORIGIN=*
